# =====================================================================
# EmailJS Configuration for Sri Venkateshwara Earth Movers
# =====================================================================
# Follow these steps to obtain your credentials:
# 1. Sign up at https://www.emailjs.com/
# 2. Add an Email Service connected to srivenkateshwaravechicles@gmail.com
# 3. Create an Email Template with ID below
# 4. Copy your Public Key from Account Settings -> API Keys
# =====================================================================

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
VITE_EMAILJS_TO_EMAIL=srivenkateshwaravechicles@gmail.com
